# Copy this file to .streamlit/secrets.toml and replace the placeholders you use.
# Never commit the real secrets.toml file.
GEMINI_API_KEY = "YOUR_GEMINI_API_KEY"
GEMINI_MODEL = "models/gemini-3.5-flash-lite"

# Use "session" until the Supabase migration has been applied.
# Switch to "supabase" for durable history across browsers and restarts.
AUDIT_BACKEND = "session"
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY = "YOUR_SERVER_SIDE_SUPABASE_SECRET_KEY"
SUPABASE_AUDIT_TABLE = "vendor_runs"

# At least 12 characters. Share only with the intended demo reviewer.
REVIEWER_ACCESS_CODE = "YOUR_LONG_RANDOM_REVIEWER_ACCESS_CODE"
